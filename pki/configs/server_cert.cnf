# pki/configs/server_cert.cnf
[ req ]
default_bits        = 4096
prompt              = no
default_md          = sha256
distinguished_name  = dn
req_extensions      = v3_req

[ dn ]
C  = RU
ST = Moscow
O  = VPN Research Lab
OU = Server
CN = vpn-server.internal

[ v3_req ]
subjectAltName = @alt_names
keyUsage       = critical, digitalSignature, keyEncipherment
extendedKeyUsage = serverAuth

[ alt_names ]
DNS.1 = vpn-server.internal
DNS.2 = localhost
IP.1  = 127.0.0.1
